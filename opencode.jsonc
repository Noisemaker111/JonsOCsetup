        },
        {
          "action": "patch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "grok": {
      "description": "Grok 4.6 worker via CLIProxyAPI. Picked by model hint grok.",
      "mode": "all",
      "hidden": false,
      "model": "cliproxyapi/grok-4.6",
      "tools": {
        "task": false,
        "subagent": false
      },
      "permissions": [
        {
          "action": "task",
          "resource": "*",
