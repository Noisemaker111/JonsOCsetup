        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "write",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "patch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "astra": {
      "description": "GPT-6 Astra worker via OpenAI. Picked by model hint openai/gpt-6-astra; Quest policy controls the authorized reasoning variant.",
      "mode": "all",
      "hidden": false,
      "model": "openai/gpt-6-astra",
      "tools": {
        "task": false,
        "subagent": false
      },
      "permissions": [
        {
          "action": "task",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
